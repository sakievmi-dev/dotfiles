autoload -U colors && colors
setopt PROMPT_SUBST

autoload -Uz compinit
compinit

# ===============================
# Aliases
# ===============================

# Safe file operations
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -iv'

# eza (File listing)
alias l='eza --icons -lh --group-directories-first'
alias ls='eza --icons'
alias tree='eza --icons --tree'

# Package management
alias pkgs='pacman -Qe'
alias cleano='sudo pacman -Rs $(pacman -Qqdt)'

# Utils
alias e='$EDITOR'
alias v='pulsemixer'

# Python
alias py='python'
alias venv='source .venv/bin/activate'

# ===============================
# Functions
# ===============================

# Yazi shell integration
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"

    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi

    rm -f -- "$tmp"
}

# Cmus launcher
function cmus() {
    cd ~/mnt/hdd/Media/Music/ || return
    command cmus "$@"
}


